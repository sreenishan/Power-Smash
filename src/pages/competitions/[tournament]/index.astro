---
// /competitions/<tournament-slug>/: the public events of one tournament, each linking to its own page. Static, no client JavaScript.
// Names never appear on this page. SportsEvent structured data only for real data (never for the fictional seed).
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Users from '@lucide/astro/icons/users';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import CompetitionSampleNotice from '../_parts/CompetitionSampleNotice.astro';
import { loadCompetitionSite } from '../../../lib/competition/public/load';
import { competitionTournamentJsonLd, tournamentPlace, tournamentWhen, updatedText, type CompetitionTournamentPage } from '../../../lib/competition/public/model';
import type { CompetitionSource } from '../../../lib/competition/public/provider';
import { COMPETITION_ROUTES } from '../../../lib/urls';
import { titleWithBrand } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const site = await loadCompetitionSite();
  return site.tournaments.map((t) => ({ params: { tournament: t.slug }, props: { t, source: site.source, generatedAt: site.generatedAt } }));
}) satisfies GetStaticPaths;

interface Props {
  t: CompetitionTournamentPage;
  source: CompetitionSource;
  generatedAt: string;
}
const { t, source, generatedAt } = Astro.props;
// a once-per-build snapshot: say when it was taken
const updated = updatedText(generatedAt);
const when = tournamentWhen(t);
const place = tournamentPlace(t);
const jsonLd = competitionTournamentJsonLd(t, source, Astro.site ?? Astro.url) ?? undefined;
---
<BaseLayout
  title={titleWithBrand(`${t.name}: draws and results`)}
  description={`Draws, order of play and results of ${t.name}${place ? `, ${place}` : ''}.`}
  canonicalPath={t.path}
  noindex={source === 'seed'}
  jsonLd={jsonLd}
>
  <CompetitionSampleNotice source={source} />
  <PageHero tone="dark" title={t.name} lead={place ? `${when} · ${place}` : when} crumbs={[{ name: 'Draws and results', href: COMPETITION_ROUTES.index }, { name: t.name }]} />

  <Section labelledBy="events-title">
    <SectionHeading id="events-title" title="Events" />
    {updated && <p class="mt-4 text-small text-fg-muted ps-num" data-updated-note>{updated}.</p>}
    <ul class="mt-8 grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3" data-competition-events>
      {t.events.map((e) => (
        <li>
          <article class="ps-card ps-card-hover ps-card-accent group flex h-full flex-col p-5 pt-6">
            <div class="pb-5">
              <p class="ps-eyebrow">{e.formatText}</p>
              <h3 class="mt-2 text-h4">
                <a href={e.path} class="text-heading no-underline after:absolute after:inset-0 hover:underline">{e.title}</a>
              </h3>
            </div>
            <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
              <p class="flex items-start gap-2 text-small">
                <Users size={18} aria-hidden="true" class="shrink-0 text-link" />
                <span class:list={['ps-num', e.drawPublished ? 'font-semibold' : 'text-fg-muted']}>{e.drawPublished ? `${e.entries.length} ${e.entries.length === 1 ? 'entry' : 'entries'} in the draw` : 'The draw is not published yet.'}</span>
              </p>
              <ChevronRight size={20} aria-hidden="true" class="shrink-0 text-link ps-transition group-hover:translate-x-0.5" />
            </div>
          </article>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
