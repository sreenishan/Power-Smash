---
// /tournaments/<slug>/ for BOTH kinds of tournament (D-098):
//   owner    the owner-entered list (src/content/tournaments.ts), rendered by OwnerTournamentPage.astro (spec 7.7 upcoming view);
//   archive  tournaments read from YouTube titles (PublicArchive.tournaments, D-013 eligible, Tamil Nadu only), rendered by
//            ArchiveTournamentPage.astro (spec 7.7 past view), only while TOURNAMENT_PAGES_BUILT.
// tournamentRoutes() joins the two lists and stops the build on any address clash; the archive model already keeps archive slugs
// clear of owner slugs and reserved words, so a clash would be a bug, never a silent replacement. ZERO owner pages while that list
// is empty. This file holds no page content itself.
import type { GetStaticPaths } from 'astro';
import OwnerTournamentPage from '../../components/site/OwnerTournamentPage.astro';
import ArchiveTournamentPage from '../../components/archive/ArchiveTournamentPage.astro';
import { assertValidTournaments, tournaments, type TournamentRecord } from '../../content/tournaments';
import { loadPublicArchive, type ArchiveMatch, type ArchiveTournament } from '../../lib/archive/model';
import { TOURNAMENT_PAGES_BUILT } from '../../lib/archive/provider';
import { archiveInBuild } from '../../lib/archive/in-build';
import { tournamentRoutes } from '../../lib/archive/tournament-page';

export const getStaticPaths = (async () => {
  assertValidTournaments();
  const archive = await loadPublicArchive();
  const bySlug = new Map(archive.matches.map((m) => [m.slug, m]));
  return tournamentRoutes(tournaments, archive.tournaments, TOURNAMENT_PAGES_BUILT && archiveInBuild()).map((route) => {
    if (route.kind === 'owner') {
      return { params: { slug: route.slug }, props: { kind: 'owner' as const, tournament: tournaments[route.index] as TournamentRecord } };
    }
    const t = archive.tournaments[route.index] as ArchiveTournament;
    return {
      params: { slug: route.slug },
      props: {
        kind: 'archive' as const,
        archiveTournament: t,
        matches: t.matchSlugs.flatMap((s) => (bySlug.has(s) ? [bySlug.get(s) as ArchiveMatch] : [])),
        source: archive.source,
      },
    };
  });
}) satisfies GetStaticPaths;

type Props =
  | { kind: 'owner'; tournament: TournamentRecord }
  | { kind: 'archive'; archiveTournament: ArchiveTournament; matches: ArchiveMatch[]; source: 'seed' | 'supabase' };
const props = Astro.props as Props;
---
{props.kind === 'owner'
  ? <OwnerTournamentPage tournament={props.tournament} />
  : <ArchiveTournamentPage tournament={props.archiveTournament} matches={props.matches} source={props.source} />}
