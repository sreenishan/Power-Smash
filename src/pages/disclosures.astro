---
// disclosures page (Legal-drafts worker). The wording lives in src/content/legal/disclosures.ts as data; LegalDocument.astro renders it
// and shows the draft notice (<LegalDraftNotice />) until src/content/legal/status.ts says a lawyer reviewed the page (OT-15).
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/legal/LegalDocument.astro';
import { disclosuresDoc } from '../content/legal/disclosures';
---
<BaseLayout title={disclosuresDoc.title} description={disclosuresDoc.description}>
  <LegalDocument doc={disclosuresDoc} />
</BaseLayout>
