---
// The /international/ page body (D-112): owner-entered international events, upcoming (and running now) and recent, with India dates.
// Each event has ONE link to its official page, on an allowed website only (src/lib/international/link-rules.ts and the api view).
// Nothing is copied from those sites: no results, draws, rankings, logos or player data. The link opens in a new tab with
// rel="noopener noreferrer nofollow" and says where it goes. Static, no client JavaScript; noindex while the data is the sample seed.
// Look: one fixed card layout (status chip, name, then dates, place and level always in that order, so dates line up across a row;
// the official link is one quiet row pinned to the card's bottom edge), equal-height cards, compact even section rhythm.
import ExternalLink from '@lucide/astro/icons/external-link';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import MapPin from '@lucide/astro/icons/map-pin';
import Trophy from '@lucide/astro/icons/trophy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import StatusBadge from '../../../components/competition/StatusBadge.astro';
import type { BadgeTone } from '../../../components/competition/helpers';
import InternationalSampleNotice from './InternationalSampleNotice.astro';
import { loadInternationalPage } from '../../../lib/international/public/load';
import { INTERNATIONAL_PATH } from '../../../lib/international/in-build';
import { RECENT_DAYS, type InternationalItem } from '../../../lib/international/public/model';
import { EXTERNAL_LINK_REL, linkLabel, OFFICIAL_SITE_NOTE } from '../../../lib/international/public/text';
import { path } from '../../../lib/urls';
import { titleWithBrand } from '../../../lib/seo';

const page = await loadInternationalPage();
// The status chip of a card: the words carry the meaning, the tone only repeats them (never colour alone).
const badge = (e: InternationalItem, recent: boolean): { text: string; tone: BadgeTone } =>
  recent ? { text: 'Finished', tone: 'court' } : e.ongoing ? { text: 'Running now', tone: 'ink' } : { text: 'Upcoming', tone: 'neutral' };
const sections: Array<{ id: string; title: string; items: InternationalItem[]; empty: string; recent: boolean }> = [
  { id: 'international-upcoming', title: 'Upcoming and running now', items: page.upcoming, empty: 'No upcoming international events are listed yet.', recent: false },
  { id: 'international-recent', title: 'Recent', items: page.recent, empty: `No international events finished in the last ${RECENT_DAYS} days.`, recent: true },
];
const countText = (n: number) => (n === 1 ? '1 event' : `${n} events`);
---
<BaseLayout
  title={titleWithBrand('International events')}
  description="Major international badminton events, with dates in India time and a link to each event's official page."
  canonicalPath={path(INTERNATIONAL_PATH)}
  noindex={page.source === 'seed'}
>
  <InternationalSampleNotice source={page.source} />
  <PageHero tone="dark" title="International events" lead={OFFICIAL_SITE_NOTE} crumbs={[{ name: 'International events' }]} />

  <div class="ps-intl-sections">
    {sections.map((s) => (
      <Section compact labelledBy={`${s.id}-title`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id={`${s.id}-title`} class="text-h3">{s.title}</h2>
          {s.items.length > 0 && <p class="ps-num text-small font-semibold text-fg-muted">{countText(s.items.length)}</p>}
        </div>
        {s.items.length === 0 ? (
          <EmptyState title={s.empty} level={3} class="mt-5">
            <p>Events appear here when Power Smash lists them.</p>
          </EmptyState>
        ) : (
          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-international-list={s.id}>
            {s.items.map((e) => {
              const b = badge(e, s.recent);
              return (
                <li class="ps-card ps-card-hover ps-intl-card" data-international-event>
                  <div class="flex flex-col items-start gap-3 p-5">
                    <StatusBadge text={b.text} tone={b.tone} />
                    <h3 class="text-h4 normal-case leading-snug text-heading">{e.name}</h3>
                    <dl class="ps-intl-meta">
                      <div>
                        <dt><CalendarDays size={16} aria-hidden="true" /><span class="sr-only">Dates (India time)</span></dt>
                        <dd class="ps-num font-semibold text-fg">{e.when}</dd>
                      </div>
                      <div>
                        <dt><MapPin size={16} aria-hidden="true" /><span class="sr-only">Place</span></dt>
                        <dd>{e.place}</dd>
                      </div>
                      {e.level && (
                        <div>
                          <dt><Trophy size={16} aria-hidden="true" /><span class="sr-only">Level</span></dt>
                          <dd>{e.level}</dd>
                        </div>
                      )}
                    </dl>
                  </div>
                  <a href={e.url} target="_blank" rel={EXTERNAL_LINK_REL} class="ps-intl-link" data-official-link>
                    <span>{linkLabel(e.host)}<span class="sr-only"> (opens the official site in a new tab)</span></span>
                    <ExternalLink size={18} aria-hidden="true" />
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </Section>
    ))}
  </div>

  <Section compact tone="surface" labelledBy="international-about-title">
    <h2 id="international-about-title" class="text-h3">About this list</h2>
    <p class="mt-3 max-w-prose text-fg-muted">Dates are shown as calendar dates in India time, as Power Smash entered them. Details and results on the official site: Power Smash does not copy results, draws, rankings, logos or player details from other websites.</p>
  </Section>
</BaseLayout>

<style>
  /* The two list bands share one rhythm: a little more air above the first and below the last than between them. */
  .ps-intl-sections {
    padding-block: 1rem;
  }
  @media (min-width: 64rem) {
    .ps-intl-sections {
      padding-block: 2rem;
    }
  }
  .ps-intl-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ps-intl-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: var(--ps-text-small);
    line-height: var(--ps-lh-small);
    color: var(--ps-fg-muted);
  }
  .ps-intl-meta > div {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    align-items: start;
    gap: 0.625rem;
  }
  .ps-intl-meta dt {
    display: flex;
    height: 1.3125rem;
    align-items: center;
    color: var(--ps-court-text);
  }
  /* The official link: one quiet full-width row on the card's bottom edge, the icon in line with the text (44 px target). */
  .ps-intl-link {
    display: flex;
    min-height: var(--ps-tap);
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--ps-line);
    background: var(--ps-bg);
    font-size: var(--ps-text-small);
    line-height: var(--ps-lh-small);
    font-weight: 600;
    color: var(--ps-link);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition-property: color, background-color;
    transition-duration: var(--ps-dur-base);
    transition-timing-function: var(--ps-ease);
  }
  .ps-intl-link:hover {
    background: var(--ps-court-tint);
    color: var(--ps-link-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ps-intl-link:focus-visible {
    outline-offset: -3px;
  }
  .ps-intl-link > svg {
    flex: none;
  }
</style>
