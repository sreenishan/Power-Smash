---
// 404 (spec 7.17). Popular links and WhatsApp. No search box yet (search arrives with the archive in M2). Always noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import WhatsAppButton from '../components/site/WhatsAppButton.astro';
import { PAGE_META, titleWithBrand } from '../lib/seo';
import { ROUTES } from '../lib/urls';

const meta = PAGE_META.notFound;
const popular = [
  { label: 'Services', href: ROUTES.services },
  { label: 'Pricing', href: ROUTES.pricing },
  { label: 'Book coverage', href: ROUTES.book },
  { label: 'Tournaments', href: ROUTES.tournaments },
  { label: 'Partner with us', href: ROUTES.partner },
  { label: 'Contact', href: ROUTES.contact },
];
---
<BaseLayout title={titleWithBrand(meta.title)} description={meta.description} noindex>
  <Section tone="dark" pattern labelledBy="nf-title">
    <p class="ps-eyebrow mb-3">Error 404</p>
    <h1 id="nf-title">Page not found</h1>
    <span aria-hidden="true" class="ps-rule"></span>
    <p class="mt-4 max-w-2xl text-lead text-fg-muted">
      That page does not exist, or it has moved. Try one of these instead.
    </p>
    <ul class="mt-8 grid max-w-3xl gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((link) => (
        <li><Button href={link.href} variant="quiet" class="w-full">{link.label}</Button></li>
      ))}
    </ul>
    <div class="ps-actions mt-8">
      <Button href={ROUTES.home} variant="volt">Go to the home page</Button>
      <WhatsAppButton text="Hi Power Smash, I could not find a page on your website." label="Ask on WhatsApp" variant="quiet" source="404" />
    </div>
  </Section>
</BaseLayout>
