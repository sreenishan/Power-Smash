---
// About (spec 7.15). The factual intro is the spec's own description of the brand (spec section 1). Story, mission, team and
// districts are owner-supplied: each is hidden until site.about has it (OwnerSection). Nothing is invented here.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import StatCounter from '../components/ui/StatCounter.astro';
import OwnerSection from '../components/site/OwnerSection.astro';
import { site } from '../content/site';
import { PAGE_META, titleWithBrand } from '../lib/seo';
import { ROUTES } from '../lib/urls';

const meta = PAGE_META.about;
---
<BaseLayout title={titleWithBrand(meta.title)} description={meta.description}>
  <PageHero
    tone="dark"
    title="About Power Smash"
    lead="A YouTube-first badminton media brand for Tamil Nadu players and tournaments."
    crumbs={[{ name: 'About' }]}
  />

  <Section labelledBy="who-title">
    <SectionHeading id="who-title" title="Who we are" />
    <div class="mt-4 flex max-w-3xl flex-col gap-3">
      <p>
        Power Smash is dedicated to Tamil Nadu badminton players and tournaments: district, state, South India level and
        open events. The YouTube channel has memberships, and Power Smash is also on Instagram and Facebook.
      </p>
      <OwnerSection when={site.about.story} name="about-story">
        <p class="whitespace-pre-line">{site.about.story}</p>
      </OwnerSection>
    </div>
  </Section>

  <section aria-labelledby="numbers-title" class="ps-surface-dark py-section">
    <div class="ps-container">
      <h2 id="numbers-title" class="text-h3">The channel in numbers</h2>
      <span aria-hidden="true" class="ps-rule"></span>
      <div class="mt-6 grid max-w-xl grid-cols-2 gap-4">
        <StatCounter value={site.channel.subscribers} label="Subscribers" />
        <StatCounter value={site.channel.videos} label="Videos" />
      </div>
      <p class="mt-3 text-small text-fg-muted">Rounded figures from the Power Smash YouTube channel, as of {site.channel.asOf}.</p>
    </div>
  </section>

  <OwnerSection when={site.about.mission} name="about-mission">
    <Section labelledBy="mission-title">
      <SectionHeading id="mission-title" title="Our mission" />
      <p class="mt-4 max-w-3xl whitespace-pre-line">{site.about.mission}</p>
    </Section>
  </OwnerSection>

  <OwnerSection when={site.about.team} name="about-team">
    <Section tone="surface" labelledBy="team-title">
      <SectionHeading id="team-title" title="The team" />
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {site.about.team.map((person) => (
          <li class="ps-card ps-card-accent p-5">
            <p class="font-bold text-fg">{person.name}</p>
            <p class="text-fg-muted">{person.role}</p>
          </li>
        ))}
      </ul>
    </Section>
  </OwnerSection>

  <OwnerSection when={site.about.districts} name="about-districts">
    <Section labelledBy="districts-title">
      <SectionHeading id="districts-title" title="Districts covered" />
      <ul class="mt-6 flex flex-wrap gap-2">
        {site.about.districts.map((district) => (
          <li class="ps-chip ps-chip-court">{district}</li>
        ))}
      </ul>
    </Section>
  </OwnerSection>

  <Section tone="surface" labelledBy="next-title" compact>
    <h2 id="next-title" class="text-h3">Work with us</h2>
    <div class="ps-actions mt-4">
      <Button href={ROUTES.services} variant="primary">Coverage and services</Button>
      <Button href={ROUTES.partner} variant="secondary">Partner with us</Button>
      <Button href={ROUTES.contact} variant="secondary">Contact</Button>
    </div>
  </Section>
</BaseLayout>
