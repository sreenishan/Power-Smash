---
// content-removal page (Legal-drafts worker). The wording lives in src/content/legal/contentRemoval.ts as data; LegalDocument.astro renders it
// and shows the draft notice (<LegalDraftNotice />) until src/content/legal/status.ts says a lawyer reviewed the page (OT-15).
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/legal/LegalDocument.astro';
import { contentRemovalDoc } from '../content/legal/contentRemoval';
---
<BaseLayout title={contentRemovalDoc.title} description={contentRemovalDoc.description}>
  <LegalDocument doc={contentRemovalDoc} />
</BaseLayout>
