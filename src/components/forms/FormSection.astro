---
// The band that holds an enquiry form: the form (default slot) next to a short "good to know" column (slot "aside") and
// a WhatsApp button next to the form (D-025). On a phone the WhatsApp button sits above the form, on a desktop in the
// right-hand column; both come from waLink() through the shared WhatsAppButton and are hidden without a number.
// When the spam-check key is missing in a non-development build the form is NOT rendered: the strict release gate then
// finds the Todo text below and fails the build until OT-41 is done (D-034), and visitors get the WhatsApp button.
// The form is switched on by JavaScript (it is disabled in the page until it has loaded, review B-10): the <noscript> block
// below explains that and offers WhatsApp to visitors who have JavaScript turned off.
import Section from '../ui/Section.astro';
import Todo from '../site/Todo.astro';
import WhatsAppButton from '../site/WhatsAppButton.astro';
import { whatsappTextForPath } from '../site/whatsappText';
import { site } from '../../content/site';
import { waLink } from '../../lib/whatsapp';

interface Props {
  /** Id of the section (a link target such as #enquiry). */
  id?: string;
  /** Accessible name of the section (also its visually hidden heading). */
  title: string;
  /** Route, used for the prefilled WhatsApp text, e.g. "/book". */
  route: string;
  /** True when the spam-check key is missing in a non-development build. */
  blocked: boolean;
  tone?: 'default' | 'surface';
  /** Tighter vertical padding, for a form band that follows another compact band (the registration page). */
  compact?: boolean;
}
const { id, title, route, blocked, tone = 'default', compact = false } = Astro.props;
const headingId = `${id ?? route.replace(/\W+/g, '-')}-title`;
const text = whatsappTextForPath(route);
const hasWhatsApp = waLink(site.whatsappNumber, text) !== null;
---
<Section id={id} labelledBy={headingId} tone={tone} compact={compact}>
  <h2 id={headingId} class="sr-only">{title}</h2>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start">
    <div class="flex min-w-0 flex-col gap-4">
      <div class="ps-form-wa lg:hidden">
        <WhatsAppButton text={text} label="Prefer WhatsApp? Message us" variant="secondary" source="form-top" class="w-full sm:w-auto" />
      </div>
      {blocked ? (
        <div class="flex flex-col gap-3 rounded-lg border-2 border-line-strong bg-surface p-4 shadow-card sm:p-6">
          <h3 class="text-h3 normal-case">This form is not switched on yet</h3>
          <p>Please message us on WhatsApp instead. We will help you there.</p>
          <p><Todo what="PUBLIC_TURNSTILE_SITE_KEY (OT-41): the spam-check key for the enquiry forms" /></p>
        </div>
      ) : (
        <>
          <slot />
          <noscript>
            <div class="flex flex-col gap-3 rounded-lg border-2 border-line-strong bg-surface p-4 shadow-card sm:p-6">
              <h3 class="text-h3 normal-case">This form needs JavaScript</h3>
              <p>
                The form above only works with JavaScript turned on in your browser. Please turn it on and reload this page{hasWhatsApp ? ', or message us on WhatsApp instead and we will help you there.' : '.'}
              </p>
              <WhatsAppButton text={text} label="Message us on WhatsApp" variant="primary" source="form-noscript" class="w-full sm:w-auto" />
            </div>
          </noscript>
        </>
      )}
    </div>
    <aside class="ps-card ps-card-accent ps-form-aside flex flex-col gap-4 p-5 pt-6 sm:p-6 sm:pt-7 lg:sticky lg:top-24" aria-label="Good to know">
      <slot name="aside" />
      <div class="hidden lg:block">
        <WhatsAppButton text={text} label="Prefer WhatsApp? Message us" variant="secondary" source="form-side" class="w-full" />
      </div>
    </aside>
  </div>
</Section>

<style is:global>
  /* A framed tick-box row (class ps-tick on the <label> that wraps the box), the same look as the choice rows of the enquiry
     forms (ChoiceField.tsx Tick): the whole row is the tap target, a 2 px line-strong edge (3:1 against the panel), the court
     tint when ticked, the alert edge when the box has an error. Lives here, with the band that holds every form, so the forms'
     JavaScript carries one short class name instead of a long class string. */
  .ps-tick {
    display: flex;
    min-height: var(--ps-tap);
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border: 2px solid var(--ps-line-strong);
    border-radius: var(--ps-radius-md);
    background: var(--ps-surface);
    color: var(--ps-fg);
    cursor: pointer;
    transition-property: border-color, background-color;
    transition-duration: var(--ps-dur-base);
    transition-timing-function: var(--ps-ease);
  }
  .ps-tick:hover {
    border-color: var(--ps-ink-line);
  }
  .ps-tick:has(:checked) {
    border-color: var(--ps-court-text);
    background: var(--ps-court-tint);
  }
  .ps-tick:has([aria-invalid="true"]) {
    border-color: var(--ps-live-text);
    background: var(--ps-live-tint);
  }
  .ps-tick > input[type="checkbox"] {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    margin: 0;
    accent-color: var(--ps-court);
    cursor: pointer;
  }
  fieldset:disabled .ps-tick {
    cursor: wait;
  }
</style>
