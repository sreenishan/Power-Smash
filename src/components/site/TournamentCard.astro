---
// Tournament card for /tournaments and the Home teaser (spec 5.5 TournamentCard: date block, level badge, place).
// Dates are IST calendar dates and are formatted only through src/lib/dates.ts. The link uses the canonical slash form (R-LINKS).
// Optional: `phase` adds a "Happening now" chip for a tournament running today; `featured` adds the owner's "Featured" ribbon (spec 7.6).
import { formatDateRange } from '../../lib/dates';
import { path } from '../../lib/urls';
import { tournamentPlace, tournamentStatusLabel, type TournamentPhase, type TournamentRecord } from '../../content/tournaments';

interface Props {
  tournament: TournamentRecord;
  headingLevel?: 2 | 3;
  phase?: TournamentPhase;
  featured?: boolean;
}
const { tournament: t, headingLevel = 3, phase, featured = false } = Astro.props;
const Tag = headingLevel === 2 ? 'h2' : 'h3';
const place = tournamentPlace(t);
const statusLabel = tournamentStatusLabel(t);
---
<article class="ps-card ps-card-hover ps-card-accent relative flex h-full flex-col p-5 pt-6">
  {featured && (
    <p class="absolute right-0 top-0 rounded-bl-md bg-ps-volt px-3 py-1 font-[family-name:var(--ps-font-display)] text-small font-extrabold uppercase tracking-wider text-ps-ink">Featured</p>
  )}
  <p class="ps-eyebrow ps-num">{formatDateRange(t.startDate, t.endDate)}</p>
  <Tag class="mt-2 text-h4"><a href={path(`/tournaments/${t.slug}`)} class="text-heading no-underline after:absolute after:inset-0 hover:underline">{t.name}</a></Tag>
  {place && <p class="mt-2 text-fg-muted">{place}</p>}
  <ul class="mt-auto flex flex-wrap gap-2 pt-4">
    {phase === 'ongoing' && <li class="ps-chip ps-chip-live">Happening now</li>}
    {statusLabel && <li class="ps-chip ps-chip-live">{statusLabel}</li>}
    {t.level && <li class="ps-chip ps-chip-court">{t.level}</li>}
    {t.coveredByPowerSmash && <li class="ps-chip ps-chip-ink">Covered by Power Smash</li>}
  </ul>
</article>
