---
// How to pay an event's entry fee (D-111): ONLY the owner's own texts, shown only when the owner set them (no default text, UPI id or
// payee, D-021). The UPI id is the payee's public address, shown with the name it pays so the payer can check it before paying; it is
// text, never a payment button: the site starts no payment and never asks for card or UPI credentials. Static, no client JavaScript.
import type { RegistrationPayment } from '../../lib/registration/public/model';

interface Props {
  headingId: string;
  feeText: string | null;
  payment: RegistrationPayment;
}
const { headingId, feeText, payment } = Astro.props;
---
<div class="max-w-3xl" data-payment-details>
  <h2 id={headingId} class="text-h3">How to pay the entry fee</h2>
  {feeText && <p class="mt-2 text-body">Entry fee: <strong class="ps-num">{feeText}</strong></p>}
  {payment.upiId && payment.payeeName && (
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-body">
      <dt class="font-semibold">UPI id</dt>
      <dd class="break-all font-mono" data-upi-id>{payment.upiId}</dd>
      <dt class="font-semibold">Paid to</dt>
      <dd data-payee>{payment.payeeName}</dd>
    </dl>
  )}
  {payment.instructions && <p class="mt-3 whitespace-pre-line text-body" data-payment-instructions>{payment.instructions}</p>}
  <p class="mt-3 text-small text-fg-muted">Check that the name your payment app shows matches the name above before you pay. Keep the transaction reference.</p>
</div>
