---
// How to pay an event's entry fee (D-111): ONLY the owner's own texts, shown only when the owner set them (no default text, UPI id or
// payee, D-021). The UPI id is the payee's public address, shown with the name it pays so the payer can check it before paying; it is
// text, never a payment button: the site starts no payment and never asks for card or UPI credentials. Static, no client JavaScript.
// Look: one "how to pay" card: the fee as a large tabular figure, the UPI id and payee as labelled rows, the owner's instructions,
// then the "check the name" advice as a small callout (an icon plus words, never colour alone).
import Wallet from '@lucide/astro/icons/wallet';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import type { RegistrationPayment } from '../../lib/registration/public/model';

interface Props {
  headingId: string;
  feeText: string | null;
  payment: RegistrationPayment;
}
const { headingId, feeText, payment } = Astro.props;
const hasUpi = Boolean(payment.upiId && payment.payeeName);
---
<div class="ps-card ps-card-accent ps-pay max-w-3xl" data-payment-details>
  <div class="ps-pay-head">
    <span class="ps-icon-tile" aria-hidden="true"><Wallet size={22} /></span>
    <h2 id={headingId} class="text-h3">How to pay the entry fee</h2>
  </div>

  {(feeText || hasUpi) && (
    <dl class="ps-pay-rows">
      {feeText && (
        <div class="ps-pay-fee">
          <dt>Entry fee</dt>
          <dd class="ps-num">{feeText}</dd>
        </div>
      )}
      {hasUpi && (
        <div>
          <dt>UPI id</dt>
          <dd class="break-all font-mono" data-upi-id>{payment.upiId}</dd>
        </div>
      )}
      {hasUpi && (
        <div>
          <dt>Paid to</dt>
          <dd class="font-semibold" data-payee>{payment.payeeName}</dd>
        </div>
      )}
    </dl>
  )}

  {payment.instructions && <p class="ps-pay-text whitespace-pre-line" data-payment-instructions>{payment.instructions}</p>}

  <p class="ps-note ps-pay-callout">
    <ShieldCheck size={20} aria-hidden="true" class="ps-note-icon" />
    <span>Check that the name your payment app shows matches the name above before you pay. Keep the transaction reference.</span>
  </p>
</div>

<style>
  .ps-pay {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem 1.25rem;
  }
  @media (min-width: 40rem) {
    .ps-pay {
      padding: 1.75rem 1.75rem 1.5rem;
    }
  }
  .ps-pay-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  /* Labelled rows: label on the left (a fixed column from 640 px up, stacked above the value on a phone), hairline between rows. */
  .ps-pay-rows {
    border-block: 1px solid var(--ps-line);
  }
  .ps-pay-rows > div {
    display: grid;
    gap: 0.125rem 1rem;
    padding-block: 0.75rem;
  }
  .ps-pay-rows > div + div {
    border-top: 1px solid var(--ps-line);
  }
  @media (min-width: 40rem) {
    .ps-pay-rows > div {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .ps-pay-rows dt {
    font-size: var(--ps-text-small);
    line-height: var(--ps-lh-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ps-fg-muted);
  }
  .ps-pay-rows dd {
    min-width: 0;
    color: var(--ps-fg);
  }
  /* The fee: the figure a payer needs, at h3 size in the display face with tabular numbers. */
  .ps-pay-fee dd {
    font-family: var(--ps-font-display);
    font-size: var(--ps-text-h3);
    font-weight: 800;
    line-height: 1.1;
    color: var(--ps-heading);
  }
  .ps-pay-text {
    max-width: 65ch;
  }
  .ps-pay-callout {
    max-width: 65ch;
  }
</style>
