---
// The top band of an inner page: breadcrumbs, the ONE h1, a lead line and (default slot) the action buttons.
// tone "dark" = ink broadcast band (volt buttons are allowed there), "light" = white band with a bottom edge.
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  name: string;
  href?: string;
}
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  /** Breadcrumb items after Home. Omit on the Home page. */
  crumbs?: readonly Crumb[];
  tone?: 'dark' | 'light';
}
const { title, lead, eyebrow, crumbs, tone = 'light' } = Astro.props;
const hasActions = Astro.slots.has('default');
---
<section class:list={['ps-hero', tone === 'dark' ? 'ps-surface-dark' : 'ps-hero-light border-b border-line']}>
  <div class="ps-container">
    {crumbs && <Breadcrumbs items={crumbs} class="mb-5" />}
    {eyebrow && <p class="ps-eyebrow mb-3">{eyebrow}</p>}
    <h1 class="ps-rise max-w-4xl">{title}</h1>
    <span aria-hidden="true" class="ps-rule ps-rise ps-rise-2"></span>
    {lead && <p class="ps-rise ps-rise-2 mt-5 max-w-2xl text-lead text-fg-muted">{lead}</p>}
    {hasActions && <div class="ps-rise ps-rise-2 mt-8 flex flex-wrap gap-3"><slot /></div>}
  </div>
</section>
