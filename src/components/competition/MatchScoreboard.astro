---
// One match's scoreboard (Module 15 building block). Server-rendered, no client JavaScript.
// - Game scores in a real table (caption, row and column headers), side A first. Broadcast layout: the name column takes the free
//   width (a doubles pair breaks only between its two players, never inside a name), the game columns are narrow and fixed, Barlow tabular numerals. The short
//   visible headers ("G1", "Won") carry the full words for screen readers ("Game 1", "Games won").
// - Status badge is always text. "Live" appears ONLY when the caller passes live=true, the status is `live`, AND lastUpdate is an
//   instant no older than the freshness window (default 5 minutes, see LIVE_FRESHNESS_MS_DEFAULT in ./helpers.ts). `now` is
//   injected by the caller (a static page passes its build time, so a built page is never "Live" for long). Otherwise no live
//   label; a match marked live without a fresh update says the score may be out of date.
// - Winner marked with the word "Winner" (a result line, and a screen-reader word in the row) plus a tick, bold text and an accent
//   edge in the row: never by colour alone. Names through ./helpers.ts ("Protected player" unless the caller marks a player
//   `protected: false`, D-012 fail closed).
import Check from '@lucide/astro/icons/check';
import Trophy from '@lucide/astro/icons/trophy';
import StatusBadge from './StatusBadge.astro';
import {
  LIVE_FRESHNESS_MS_DEFAULT,
  courtText,
  displayGames,
  eventLabel,
  formatDateIst,
  formatTimeIst,
  freshnessWindowText,
  gamesWon,
  isWinner,
  outcomeNote,
  roundLabel,
  sideName,
  statusBadge,
  type PlayerRef,
} from './helpers';
import type { GameScore, MatchStatus, Side } from '../../lib/competition/types';

interface Props {
  a: readonly PlayerRef[];
  b: readonly PlayerRef[];
  status: MatchStatus;
  games?: readonly GameScore[];
  winner?: Side | null;
  event?: string | null;
  round?: string | null;
  court?: string | number | null;
  /** The caller's claim that the match is live; shown only with a fresh lastUpdate. */
  live?: boolean;
  /** ISO instant (with zone) of the last score update. */
  lastUpdate?: string | null;
  /** The clock, injected (never read here). */
  now: Date;
  freshnessMs?: number;
  headingLevel?: 2 | 3 | 4;
}
const { a, b, status, games, winner, event, round, court, live, lastUpdate, now, freshnessMs = LIVE_FRESHNESS_MS_DEFAULT, headingLevel = 3 } = Astro.props;
const Tag = headingLevel === 2 ? 'h2' : headingLevel === 4 ? 'h4' : 'h3';
const badge = statusBadge({ live, status, lastUpdate, now, freshnessMs });
const rows = displayGames(games);
const won = gamesWon(rows);
const nameA = sideName(a);
const nameB = sideName(b);
const winA = isWinner('A', winner, status);
const winB = isWinner('B', winner, status);
const note = outcomeNote(status);
const context = [eventLabel(event), roundLabel(round), court != null && court !== '' ? courtText(court).replace(/ /g, '\u00a0') : ''].filter(Boolean).join(' · ');
const updatedText = lastUpdate ? [formatDateIst(lastUpdate), formatTimeIst(lastUpdate)].filter(Boolean).join(', ') : '';
const caption = `Game scores: ${nameA} versus ${nameB}`;
// A doubles pair prints one player per line; the slash stays in the text (glued to the first name by a no-break space) so it
// still reads and copies as one pair.
const players = (name: string): string[] => name.split(' / ');
const sides = [
  { name: nameA, win: winA, mine: (g: GameScore) => g.a, theirs: (g: GameScore) => g.b, total: won.a },
  { name: nameB, win: winB, mine: (g: GameScore) => g.b, theirs: (g: GameScore) => g.a, total: won.b },
];
---
<article class="ps-card ps-sb" data-scoreboard data-live={badge.isLive ? 'true' : 'false'}>
  <div class="ps-sb-head">
    {context ? <p class="ps-sb-context">{context}</p> : <span></span>}
    <StatusBadge text={badge.text} tone={badge.tone} />
  </div>
  <Tag class="ps-sb-title">
    <span class:list={{ 'ps-sb-title-win': winA }}>{players(nameA).map((p, i) => <>{i > 0 && ' / '}<span class="ps-sb-nw">{p}</span></>)}</span>
    <span class="ps-sb-vs"> versus </span>
    <span class:list={{ 'ps-sb-title-win': winB }}>{players(nameB).map((p, i) => <>{i > 0 && ' / '}<span class="ps-sb-nw">{p}</span></>)}</span>
  </Tag>
  {rows.length > 0 ? (
    <div class="ps-sb-scroll" role="region" aria-label={caption} tabindex="0">
      <table class="ps-scoretable">
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr>
            <th scope="col" class="ps-scoretable-side"><span class="sr-only">Side</span></th>
            {rows.map((_, i) => (
              <th scope="col"><span aria-hidden="true">G{i + 1}</span><span class="sr-only">Game {i + 1}</span></th>
            ))}
            <th scope="col"><span aria-hidden="true">Won</span><span class="sr-only">Games won</span></th>
          </tr>
        </thead>
        <tbody>
          {sides.map((s) => (
            <tr class:list={{ 'ps-scoretable-winner': s.win }}>
              <th scope="row">
                <span class="ps-scoretable-name">
                  <span class="ps-scoretable-mark" aria-hidden="true">{s.win && <Check size={16} stroke-width={3} />}</span>
                  <span class="ps-scoretable-players">
                    {players(s.name).map((p, i, all) => <span>{p}{i < all.length - 1 && <>&nbsp;/ </>}</span>)}
                  </span>
                </span>
                {s.win && <span class="sr-only"> (winner)</span>}
              </th>
              {rows.map((g) => <td class:list={['ps-scoretable-game', { 'ps-scoretable-took': s.mine(g) > s.theirs(g) }]}>{s.mine(g)}</td>)}
              <td class="ps-scoretable-total"><span>{s.total}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="ps-sb-empty">{note ? `${note}: no games played.` : 'No score yet.'}</p>
  )}
  {(winA || winB) && (
    <p class="ps-sb-result">
      <Trophy size={18} aria-hidden="true" class="ps-sb-result-icon" />
      <span>Winner: <strong>{players(winA ? nameA : nameB).map((p, i) => <>{i > 0 && ' / '}<span class="ps-sb-nw">{p}</span></>)}</strong>{note && ` (${note.toLowerCase()})`}</span>
    </p>
  )}
  {badge.isLive && updatedText && (
    <p class="mt-2 text-caption text-fg-muted">Last updated {updatedText}. Shown as live only while updates are less than {freshnessWindowText(freshnessMs)} old.</p>
  )}
  {badge.stale && (
    <p class="mt-2 text-caption text-fg-muted">This score may be out of date{updatedText ? ` (last update ${updatedText})` : ''}.</p>
  )}
</article>

<style>
  .ps-sb {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1rem;
  }
  @media (min-width: 40rem) {
    .ps-sb {
      padding: 1.25rem 1.5rem;
    }
  }
  /* The badge always sits top right; the context line wraps beside it. */
  .ps-sb-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }
  .ps-sb-context {
    font-size: var(--ps-text-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ps-fg-muted);
  }
  /* "A versus B" in the same body type as the order of play. */
  .ps-sb-title {
    margin-top: 0.5rem;
    font-family: var(--ps-font-body);
    font-size: var(--ps-text-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .ps-sb-title-win {
    font-weight: 800;
  }
  .ps-sb-vs {
    font-weight: 400;
    color: var(--ps-fg-muted);
  }
  .ps-sb-scroll {
    margin-top: 0.75rem;
    overflow-x: auto;
    border-radius: var(--ps-radius-md);
  }
  .ps-sb-empty {
    margin-top: 0.75rem;
    color: var(--ps-fg-muted);
  }
  .ps-sb-result {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.875rem;
    font-size: var(--ps-text-small);
    text-wrap: pretty;
  }
  /* A player's name never breaks inside itself (no lone initial on a line); a pair breaks only at the " / ". */
  .ps-sb-nw {
    white-space: nowrap;
  }
  .ps-sb-result :global(.ps-sb-result-icon) {
    flex: none;
    color: var(--ps-link);
  }

  .ps-scoretable {
    width: 100%;
    border-collapse: collapse;
  }
  .ps-scoretable th,
  .ps-scoretable td {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--ps-line);
  }
  .ps-scoretable tbody tr:last-child th,
  .ps-scoretable tbody tr:last-child td {
    border-bottom: 0;
  }
  .ps-scoretable thead th {
    width: 2.25rem;
    min-width: 2.25rem;
    padding: 0 0 0.375rem;
    font-size: var(--ps-text-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ps-fg-muted);
    white-space: nowrap;
  }
  @media (max-width: 26rem) {
    .ps-scoretable thead th {
      width: 2rem;
      min-width: 2rem;
    }
  }
  .ps-scoretable thead th.ps-scoretable-side {
    width: 100%;
  }
  .ps-scoretable tbody th {
    padding-right: 0.5rem;
    text-align: left;
    font-weight: 600;
    line-height: 1.3;
  }
  .ps-scoretable-name {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    padding-left: 0.5rem;
  }
  /* A fixed slot for the tick keeps both names on the same left edge. */
  .ps-scoretable-mark {
    display: inline-flex;
    flex: none;
    width: 1rem;
    height: 1.3em;
    align-items: center;
    color: var(--ps-link);
  }
  .ps-scoretable-players {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .ps-scoretable-players > span {
    display: block;
    white-space: nowrap;
  }
  .ps-scoretable-game,
  .ps-scoretable-total {
    font-family: var(--ps-font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
    color: var(--ps-fg-muted);
  }
  /* The side that took a game: full colour and heavier (the numbers themselves say who took it). */
  .ps-scoretable-took {
    font-weight: 800;
    color: var(--ps-fg);
  }
  /* Games won: a small scoreboard box, solid for the winner. */
  .ps-scoretable-total > span {
    display: inline-flex;
    min-width: 2rem;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ps-line-strong);
    border-radius: var(--ps-radius-sm);
    font-weight: 800;
    color: var(--ps-fg);
  }
  .ps-scoretable-winner th {
    font-weight: 800;
    box-shadow: inset 3px 0 0 var(--ps-link);
  }
  .ps-scoretable-winner .ps-scoretable-total > span {
    border-color: var(--ps-fg);
    background: var(--ps-fg);
    color: var(--ps-surface);
  }
  @media (forced-colors: active) {
    .ps-scoretable-winner th {
      border-left: 3px solid CanvasText;
    }
  }
</style>
