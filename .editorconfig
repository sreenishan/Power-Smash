root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing double spaces for hard line breaks only if the author
# asks for them; keep them untouched.
[*.md]
trim_trailing_whitespace = false

# Lockfiles are generated; never reformat them.
[package-lock.json]
indent_size = 2
insert_final_newline = false
