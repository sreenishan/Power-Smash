# .env.example - Power Smash (replaces spec 13.1; follows D-027 and docs/SECRETS.md)
#
# NAMES ONLY. Never put a real secret value in this file or commit one.
# This file is documentation: copy only the group you need, and only with
# DEVELOPMENT-project values.
#   Group 1 -> .env        (git-ignored; read by Astro/Vite at build time)
#   Group 2 -> .env        too, DEV values only (the Vercel functions read process.env; locally Astro reads .env)
#   Hosting is Vercel (D-097). Groups 3-8 are set in GitHub or Vercel screens, never in a local file
#   (except the owner's untracked .secrets.local, which the OWNER loads with the loader
#   at the PC, see docs/SECRETS.md). Claude Code never sees, types or pipes secret values;
#   the owner enters each one directly in the vendor's screen or runs the loader.
# Anything starting with PUBLIC_ is copied into the browser bundle: never put a
# secret there. Claude Code never uses production values locally.

# ---------------------------------------------------------------------------
# GROUP 1 - Public build variables (NOT secret). Set as repository variables for
# deploy.yml; local .env uses dev values.
# ---------------------------------------------------------------------------
# Site origin. Dev default shown. TODO(owner): production URL once the domain is verified (OT-07); powersmash.in is only a working assumption and is not bought yet.
PUBLIC_SITE_URL=http://localhost:4321
# Supabase project URL, https://<project-ref>.supabase.co (dev project locally; the project ref is not a secret).
PUBLIC_SUPABASE_URL=
# Supabase publishable key (value starts sb_publishable_). Public by design, protected by RLS and GRANTs (D-005). Never an sb_secret_ key here.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile SITE key. Value below is Cloudflare's published always-passes TEST key (dev and preview only; production key comes from OT-41).
# Source: https://developers.cloudflare.com/turnstile/troubleshooting/testing/ (checked 2026-10-20). check-release refuses this test key when indexing is on.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# WhatsApp number, digits with country code and no plus. The official number is published in spec 13.2 and goes in via site_settings and the deploy variable. Leave empty in dev and previews (D-004).
PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# GROUP 2 - Server secrets (runtime). The owner sets them in the Vercel dashboard: project, Settings,
# Environment Variables, scope Production (live) or Preview (tests); a change applies to new deployments only (VF-V7).
# Or with the loader at the PC (`npm run secrets:load -- --only vercel`, owner-run); local runs read
# .env with DEV values. (Razorpay names are in Group 7.)
# ---------------------------------------------------------------------------
# Supabase secret key (sb_secret_...). Bypasses RLS: server functions and sync only, never the build, never PUBLIC_. Prefer a separate key per component (Supabase docs).
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile SECRET key: the REAL secret from OT-41 for production. NO value is seeded here on purpose (S-1): Cloudflare's published
# TEST secrets accept ANY token, so one that reached the Production scope would switch the spam check off. For local dev and the Vercel Preview scope ONLY,
# put a test secret from https://developers.cloudflare.com/turnstile/troubleshooting/testing/ in .env (or the Preview scope) TOGETHER WITH TURNSTILE_ALLOW_TEST_KEYS=true
# (Group 9). Without that variable a test secret is refused: the lead endpoint answers "degraded" and /api/health says ready:false.
TURNSTILE_SECRET_KEY=
# Resend API key (Sending access only). Not used in M0; starts at M1 go-live after the sending domain is verified (OT-40, D-022).
RESEND_API_KEY=
# From address for outgoing mail, for example hello@<domain>. Needs the verified domain (OT-07).
EMAIL_FROM=
# The owner's address for email alerts. Private: never printed, logged or put in static HTML.
OWNER_EMAIL=
# Telegram bot token from @BotFather (OT-08). The token is part of Telegram API URLs: redact URLs in logs.
TELEGRAM_BOT_TOKEN=
# Telegram chat id of the owner's private 1:1 chat with the bot.
TELEGRAM_CHAT_ID=
# Random 32-byte key (with a key id) for HMAC hashing of IPs and sessions; replaces IP_HASH_SALT (D-027, D-029). Server only.
HMAC_KEY=
# YouTube Data API v3 key, restricted to that one API with a Google Cloud daily quota cap (OT-04, D-027). Also a GitHub secret for the sync workflow.
YOUTUBE_API_KEY=
# GitHub fine-grained token that lets the admin Publish button (and the parked cron route) start a rebuild through workflow_dispatch: Actions: write on this one repository, nothing else (OT-42, D-008). Replaces REBUILD_HOOK_URL. Vercel Production secret, not a GitHub secret.
REBUILD_DISPATCH_TOKEN=

# ---------------------------------------------------------------------------
# GROUP 3 - Sync workflow secrets (GitHub Actions secrets, used by sync.yml only).
# Same names and meaning as Group 2 for: SUPABASE_SECRET_KEY, YOUTUBE_API_KEY,
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, RESEND_API_KEY - set them separately in GitHub.
# Only this one is new:
# ---------------------------------------------------------------------------
# The channel id. Public (not a secret); the spec publishes it as this value.
YOUTUBE_CHANNEL_ID=UCRhIwO47uhJIM5Iw4uybcFQ

# ---------------------------------------------------------------------------
# GROUP 4 - Deploy workflow secrets (GitHub Actions secrets, used by deploy.yml and preview.yml only; OT-02, D-097).
# GitHub secret names cannot start with GITHUB_. These replace CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID (gone with the Cloudflare host).
# ---------------------------------------------------------------------------
# Vercel access token (Vercel account Settings, Tokens; set an end date about 3 months out). A password: only the last deploy step reads it, never `npm ci` or the build step.
VERCEL_TOKEN=
# Vercel team or account id. An identifier, not a password; kept as a secret next to the token.
VERCEL_ORG_ID=
# Vercel project id. An identifier, not a password.
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# GROUP 5 - Migrate workflow secrets (GitHub Actions secrets, used by the migrate workflow only).
# ---------------------------------------------------------------------------
# Supabase personal access token for `supabase link` and `db push` (OT-03).
SUPABASE_ACCESS_TOKEN=
# Supabase project reference (the short code in the project URL). Not a secret.
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# GROUP 6 - Backup and restore-drill workflows (D-011).
# ---------------------------------------------------------------------------
# Session-pooler connection string (port 5432) with a read-only login. Contains a password: GitHub secret for backup.yml only (OT-43).
SUPABASE_DB_URL=
# age PUBLIC key that encrypts every production backup. Public, so it is a GitHub repository VARIABLE (not a secret), added by the owner (OT-31). The matching private key is owner-only and offline.
AGE_PUBLIC_KEY=
# PUBLIC half of the drill-only age key. Also a GitHub repository VARIABLE (D-011).
AGE_DRILL_PUBLIC_KEY=
# PRIVATE half of the drill-only age key; it can only decrypt made-up dev data. GitHub SECRET for restore.yml only (D-011). The owner enters it; Claude never sees it.
AGE_DRILL_KEY=

# ---------------------------------------------------------------------------
# GROUP 7 - Phase 2 only (server secrets, entered by the owner as in Group 2). Not used in Phase 1.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GROUP 8 - Never stored in any system or file
# ---------------------------------------------------------------------------
# The age PRIVATE key for production backups is held by the owner offline only (paper or password manager, plus one sealed escrow copy). It has no variable name on purpose.

# ---------------------------------------------------------------------------
# GROUP 9 - M1 lead/event endpoint settings (Vercel environment variables or secrets; names only, appended by the Lead-backend worker)
# The endpoints (src/lib/runtime-env.ts) also read SUPABASE_SECRET_KEY, TURNSTILE_SECRET_KEY, HMAC_KEY, TELEGRAM_BOT_TOKEN,
# TELEGRAM_CHAT_ID, RESEND_API_KEY, EMAIL_FROM, OWNER_EMAIL, PUBLIC_WHATSAPP_NUMBER, PUBLIC_SUPABASE_URL and PUBLIC_SITE_URL from Groups 1 and 2.
# ---------------------------------------------------------------------------
# Exactly "true" switches email alerts and the customer acknowledgement on. Leave it unset until the sending domain is verified (OT-07, OT-40, D-022).
EMAIL_ENABLED=
# Optional. Comma-separated hostnames the Turnstile widget is served from (hostname check). Empty = the hostname of the request itself. List the real domain AND any *.vercel.app preview host that shows the form, and add the same hostnames to the widget in the Cloudflare dashboard (OT-41).
TURNSTILE_EXPECTED_HOSTNAMES=
# Optional. The Turnstile action the widget is rendered with (data-action). Default "lead". Set to "-" to skip the check. Ignored with Cloudflare's test secrets.
TURNSTILE_EXPECTED_ACTION=
# Optional. Overrides PUBLIC_SUPABASE_URL for the server functions only (same project URL, not secret).
SUPABASE_URL=
# HMAC_KEY format: <key id>:<random secret, at least 32 characters>, for example k1:<random>. The key id lets a later rotation keep old hashes readable (D-029).

# ---------------------------------------------------------------------------
# GROUP 1b - More public build variables (NOT secret). Added in M1 by the Site-shell and Infra workers.
# ---------------------------------------------------------------------------
# Indexing switch. Every page is noindex unless this is EXACTLY "true"; set it only at the public go-live G1 (BUILD_PLAN M1 item 7, D-034).
PUBLIC_ALLOW_INDEXING=false
# Cloudflare Web Analytics site token (a public identifier, not a secret). Leave empty until the owner creates the Web Analytics site; empty means no beacon is rendered.
PUBLIC_CF_ANALYTICS_TOKEN=
# HSTS max-age in seconds. Leave empty until the domain is final and verified (D-023); empty means no Strict-Transport-Security header is sent (docs/m1/infra-notes.md).
PUBLIC_HSTS_MAX_AGE=
# Strict release gate. `npm run build:strict` and deploy.yml set PS_STRICT=1 themselves (a build-time switch, not a PUBLIC_ variable); `npm run build` (the non-strict developer build) leaves it unset.
# PS_STRICT=1
# Optional. Comma-separated host suffixes that always get `noindex` (`.vercel.app` is always included). Public, not secret (D-097, docs/m3/port-B-notes.md).
PUBLIC_NOINDEX_HOST_SUFFIXES=
# Set to 1 when running `npx vitest run tests/build` so a missing build output FAILS instead of skipping those tests (CI does this after the build). Not secret.
# PS_REQUIRE_DIST=1
# Node's own heap setting, set by ci.yml and deploy.yml for the build (D-009); a local build rarely needs it. Not secret.
# NODE_OPTIONS=--max-old-space-size=6144

# ---------------------------------------------------------------------------
# GROUP 9b - M1 review-fix variables for the lead/event endpoints (Vercel environment variables; names only, appended by the Backend fix worker)
# ---------------------------------------------------------------------------
# DEV AND PREVIEW ONLY (S-1). Exactly "true" accepts Cloudflare's published Turnstile TEST secrets (which accept any token). Set it ONLY in the Vercel Preview scope; leave it UNSET in the Production scope.
# Without it a test secret in TURNSTILE_SECRET_KEY makes /api/lead answer "degraded" and /api/health report ready:false (reason turnstile_test_key).
TURNSTILE_ALLOW_TEST_KEYS=
# Exactly "true" puts the customer's WhatsApp reply link (it contains their PHONE NUMBER) and the district in the owner alert (Telegram and the owner email) (R-TELEGRAM-PHONE, S-5).
# Default (unset): the alert has only the kind, reference, first name, source page and a pointer to the lead in Supabase Studio. The owner and the lawyer decide; the privacy page must match.
TELEGRAM_ALERT_PHONE_LINK=
# LOCAL DEVELOPMENT ONLY (S-17). Exactly "true" lets SUPABASE_URL be a loopback address (http://127.0.0.1:54321). Otherwise the URL must be https://<ref>.supabase.co or the secret key is never sent. Never set it on a deployed site.
SUPABASE_ALLOW_LOCAL_URL=
# Optional whole number (default 40, set in src/lib/security/ratelimit.ts): enquiries accepted per hour across ALL visitors before new ones are refused and the owner gets one "flood protection" notice (S-6).
LEAD_GLOBAL_HOURLY_CAP=
# Optional whole number (default 100, set in src/lib/security/ratelimit.ts): enquiries STORED per 24 hours across all visitors before new ones are refused (N-3). Keeps a burst under the hourly cap from using up the free email quota. Past 80 stored enquiries in 24 hours customer acknowledgement mails stop (the owner alert stays).
LEAD_GLOBAL_DAILY_CAP=
# Not variables: LEAD_RATE_LIMITER and EVENT_RATE_LIMITER were optional Cloudflare Workers rate-limit bindings. They do not exist on Vercel (D-097);
# the database counters and the global caps above do the work. A per-IP edge limit would be a Vercel firewall rule (OT-46, unverified).

# ---------------------------------------------------------------------------
# GROUP 10 - GitHub repository switches (repository VARIABLES, set by hand on the GitHub Variables tab; names only; OT-48).
# They are read by the workflows, not by the site code. Exactly "true" turns one on; unset = off. Set each only when Claude names it.
# ---------------------------------------------------------------------------
# Switches the publish job (deploy.yml: strict build, main only) on. Leave unset until OT-02 is done (Vercel project, deploy credentials, Pro plan for a real launch) and the first test publish is agreed.
DEPLOY_ENABLED=
# Switches the weekly encrypted backup (backup.yml) on. Leave unset until OT-27, OT-31 and OT-43 are done.
BACKUP_ENABLED=
# Switches the private PREVIEW job (preview.yml: non-strict, noindex, dev values, a Vercel preview behind Vercel Authentication, never production) on. Leave unset until OT-02 and OT-47 are done.
PREVIEW_ENABLED=
# Public dev values the preview build uses (repository VARIABLES, not secrets): the DEV Supabase URL and publishable key, and a Turnstile site key (a test key is fine here).
PREVIEW_PUBLIC_SUPABASE_URL=
PREVIEW_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PREVIEW_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: also send a Telegram message when a backup fails (GitHub already emails the repository owner about failed scheduled runs).
BACKUP_TELEGRAM_ALERTS=

# ---------------------------------------------------------------------------
# GROUP 11 - M2/M3 wiring (names only; added by the Wiring worker, docs/m2/wiring-notes.md)
# ---------------------------------------------------------------------------
# GitHub repository VARIABLE. Exactly "true" switches the YouTube sync workflow (sync.yml) on. Leave unset until the Supabase project, the YouTube API key and the migrations exist.
SYNC_ENABLED=
# Vercel environment variable (plain text, Production). Exactly "true" switches the scheduled cron route (PARKED: scripts/sync-worker/vercel-cron.ts, not under src yet: rebuild dispatch, new-video check, dead-man alert) on. Needs the Vercel Pro plan for anything more often than once a day, CRON_SECRET, REBUILD_DISPATCH_TOKEN, ADMIN_GITHUB_REPO, SUPABASE_URL and SUPABASE_SECRET_KEY in Vercel (docs/m3/vercel-deploy-notes.md).
CRON_ENABLED=
# Secret. Vercel sends it as `Authorization: Bearer <value>` on every cron call; the cron route answers 401 without it (VF-V4). Production scope only. Any long random string the owner makes.
CRON_SECRET=
# Vercel environment variables (plain text, not secret) read by the admin Publish/Sync buttons AND by the cron: owner/name of this repository, the deploy workflow file (default deploy.yml), the sync workflow file (sync.yml), the branch (default main), allowed admin origins, and the editors switch (exactly "true"; off at launch).
ADMIN_GITHUB_REPO=
ADMIN_DEPLOY_WORKFLOW=
ADMIN_SYNC_WORKFLOW=
ADMIN_DISPATCH_REF=
ADMIN_ALLOWED_ORIGINS=
ADMIN_EDITORS_ENABLED=
# BUILD variable (public, NOT a secret): any random string of 8 to 128 letters, digits, "_" or "-", changed per build; it lets the sponsor-impression beacon prove a request came from this build (docs/m2/business-notes.md).
PUBLIC_PLACEMENT_BEACON_TOKEN=
# Archive source for the REAL build only (PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_PUBLISHABLE_KEY must be set too): "supabase". Unset = fictional sample data with a banner.
PS_ARCHIVE_SOURCE=
# /live source (D-101): "supabase" = the pin and past streams the owner saves in the admin Live screen (needs migration 0013 and the two PUBLIC_SUPABASE_* values). Unset = src/content/live.ts. Switching it on changes what visitors see (owner's yes).
PS_LIVE_SOURCE=

# ---------------------------------------------------------------------------
# GROUP 12 - Tournament platform waves 4 and 5 (names only; every switch is off unless it is exactly "true"; docs/m5/integration/)
# ---------------------------------------------------------------------------
# Vercel (plain text, not secret). Exactly "true" lets invited organizers and scorers sign in to the admin and work on their own tournaments (D-108). The owner's database switch (admin, Accounts) must be on too.
ORGANIZER_ACCOUNTS_ENABLED=
# Vercel (plain text, optional). The admin address an invitation link opens, for example https://<admin host>/admin/ . Must also be in Supabase Auth's allowed redirect URLs. Unset = Supabase uses the project's Site URL.
ADMIN_INVITE_REDIRECT_URL=
# Vercel (plain text). Exactly "true" opens /api/register (D-111). The owner's database switch, the event's "open" switch and features.registrations must be on too.
REGISTRATION_ENABLED=
# Vercel (plain text). Exactly "true" lets /api/live-scores/<event-id> answer (D-113), together with features.liveScores and the owner's live switch.
LIVE_SCORES_ENABLED=
# Vercel (plain text). Exactly "true" opens the email updates sign-up and confirm endpoints (D-114). Unsubscribe always works.
NOTIFY_SUBSCRIBE_ENABLED=
# BUILD variables (public, NOT secrets). "supabase" = read the owner's international events (D-112) / site notices (D-114) from the api views; unset = fictional sample data (never in a release build).
PS_INTERNATIONAL_SOURCE=
PS_NOTICES_SOURCE=
# BUILD variable, developer builds only: exactly "1" shows the fictional sample notice banner. Never in a release build.
PS_NOTICES_SAMPLE=
